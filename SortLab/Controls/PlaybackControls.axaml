<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SortLab.Controls" x:Class="SortLab.Controls.PlaybackControls">
  <WrapPanel>
    <Panel Margin="0,0,8,0">
      <Button Classes="accent" Content="Старт" IsVisible="{Binding !IsPlaying}" IsEnabled="{Binding CanStart}" x:Name="StartButton" Command="{Binding StartCommand}"/>
      <Button Classes="accent" Content="Пауза" IsVisible="{Binding CanPause}" x:Name="PauseButton" Command="{Binding PauseCommand}"/>
      <Button Classes="accent" Content="Продолжить" IsVisible="{Binding IsPaused}" x:Name="ContinueButton" Command="{Binding ContinueCommand}"/>
    </Panel>
    <Button Content="Шаг вперёд" x:Name="StepButton" Command="{Binding StepCommand}" IsEnabled="{Binding CanStep}" Margin="0,0,8,0"/>
    <Button Content="Сначала" Command="{Binding ResetCommand}"/>
  </WrapPanel>
</UserControl>
