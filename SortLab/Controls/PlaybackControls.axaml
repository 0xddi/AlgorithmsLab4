<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SortLab.Controls" x:Class="SortLab.Controls.PlaybackControls">
  <Grid ColumnDefinitions="1.4*,*,*" ColumnSpacing="6" Width="{Binding $parent[UserControl].Bounds.Width}" MaxWidth="470" HorizontalAlignment="Left">
    <Panel>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" Content="Старт" IsVisible="{Binding !IsPlaying}" IsEnabled="{Binding CanStart}" x:Name="StartButton" Command="{Binding StartCommand}"/>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" Content="Пауза" IsVisible="{Binding CanPause}" x:Name="PauseButton" Command="{Binding PauseCommand}"/>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" Content="Продолжить" IsVisible="{Binding IsPaused}" x:Name="ContinueButton" Command="{Binding ContinueCommand}"/>
    </Panel>
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="1" Content="Шаг →" x:Name="StepButton" Command="{Binding StepCommand}" IsEnabled="{Binding CanStep}"/>
    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Grid.Column="2" Content="Сначала" Command="{Binding ResetCommand}"/>
  </Grid>
</UserControl>
