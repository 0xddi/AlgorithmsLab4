<UserControl x:Class="SortLab.Controls.LogView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="600">

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <DockPanel>
      <Button x:Name="ExpandButton" DockPanel.Dock="Right" Content="Открыть весь журнал" Click="OpenFullLog"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Журнал операций" Classes="h2" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Log.CountText, FallbackValue=''}" Classes="subtle" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>

    <DataGrid x:Name="LogGrid" Grid.Row="1" Classes="compact"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              ItemsSource="{Binding Log.FilteredEntries}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="№" Binding="{Binding Step}" Width="58"
                            HeaderTemplate="{StaticResource GridHeaderTemplate}" />
        <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" Width="108"
                            HeaderTemplate="{StaticResource GridHeaderTemplate}" />
        <DataGridTextColumn Header="Индексы" Binding="{Binding Indices}" Width="78"
                            HeaderTemplate="{StaticResource GridHeaderTemplate}" />
        <DataGridTextColumn Header="Значения" Binding="{Binding Values}" Width="86"
                            HeaderTemplate="{StaticResource GridHeaderTemplate}" />
        <DataGridTemplateColumn Header="Пояснение" Width="*" MinWidth="108"
                                HeaderTemplate="{StaticResource GridHeaderTemplate}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <Grid x:Name="Filters" IsVisible="False" Grid.Row="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
      <TextBox Watermark="Фильтр по тексту..." Text="{Binding Log.FilterText}" MinWidth="0" />
      <ComboBox Grid.Column="1" MinWidth="0" ItemsSource="{Binding Log.TypeOptions}" SelectedItem="{Binding Log.SelectedType}" />
      <Button Grid.Column="2" Content="Очистить" Command="{Binding Log.ClearLogCommand}" />
    </Grid>
  </Grid>
</UserControl>
