<Application x:Class="SortLab.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SortLab.Controls"
             x:CompileBindings="False">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LinkBrush">#0066CC</SolidColorBrush>
          <SolidColorBrush x:Key="NoteBrush">#F5F5F7</SolidColorBrush>
          <SolidColorBrush x:Key="WindowBgBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBgBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorderBrush">#DADADF</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBgBrush">#F5F5F7</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleTextBrush">#636368</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#0066CC</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBgBrush">#E7E7EC</SolidColorBrush>
          <SolidColorBrush x:Key="HighlightBrush">#EAA782</SolidColorBrush>
          <SolidColorBrush x:Key="DangerBrush">#AD362E</SolidColorBrush>
          <SolidColorBrush x:Key="OkBrush">#2E7D32</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LinkBrush">#70B5FF</SolidColorBrush>
          <SolidColorBrush x:Key="NoteBrush">#29292D</SolidColorBrush>
          <SolidColorBrush x:Key="WindowBgBrush">#19191B</SolidColorBrush>
          <SolidColorBrush x:Key="CardBgBrush">#242427</SolidColorBrush>
          <SolidColorBrush x:Key="CardBorderBrush">#414146</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBgBrush">#29292D</SolidColorBrush>
          <SolidColorBrush x:Key="SubtleTextBrush">#B9B9C1</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#0069C9</SolidColorBrush>
          <SolidColorBrush x:Key="ChipBgBrush">#37373D</SolidColorBrush>
          <SolidColorBrush x:Key="HighlightBrush">#EAA782</SolidColorBrush>
          <SolidColorBrush x:Key="DangerBrush">#FF6B6B</SolidColorBrush>
          <SolidColorBrush x:Key="OkBrush">#366853</SolidColorBrush>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
      <controls:StepDurationConverter x:Key="StepDuration"/>
      <DataTemplate x:Key="StackLine"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
      <DataTemplate x:Key="RangeCardTemplate">
        <Border Classes="card rangeCard" Classes.current="{Binding IsCurrent}" Margin="0,0,0,5" Padding="9,7">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" Classes="subtle" TextWrapping="Wrap"
                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="AlgorithmReference">
        <Border Width="260" Margin="16,0,0,0" Padding="16,8,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
              <TextBlock Classes="h2" Text="Правила алгоритма"/>
              <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="SortLegend">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Обозначения" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarNormalBrush}"/>
            <TextBlock Text="Обычный"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarCompareBrush}"/>
            <TextBlock Text="{Binding CompareLegend, FallbackValue=Сравнение}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarSwapBrush}"/>
            <TextBlock Text="Перемещение"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarSortedBrush}"/>
            <TextBlock Text="Упорядочено"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarPivotBrush}"/>
            <TextBlock Text="{Binding PivotLegend, FallbackValue='Опорный / кандидат'}"/>
          </StackPanel>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="TapeLegend">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Обозначения" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource ChipBgBrush}"/>
            <TextBlock Text="Запись"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource HighlightBrush}"/>
            <TextBlock Text="Сравнение"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource OkBrush}"/>
            <TextBlock Text="Запись на ленту"/>
          </StackPanel>
        </StackPanel>
      </DataTemplate>

      <!-- Отключаем резерв 32px под иконку сортировки в шапках колонок DataGrid:
           колонки у нас не сортируются, а резерв съедал место у заголовков -->
      <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

      <!-- Шаблон заголовка колонки DataGrid: переносится по словам вместо обрезки -->
      <DataTemplate x:Key="GridHeaderTemplate">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0066CC"/>
        <ColorPaletteResources x:Key="Dark" Accent="#64ABFF"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Обязательный include: без него DataGrid не имеет шаблона и не отображает строки -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="ListBox.navigation ListBoxItem">
      <Setter Property="Padding" Value="14,15"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock.hero">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="46"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.scene">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="32,18"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource WindowBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="FlyoutPresenter.details">
      <Setter Property="MaxWidth" Value="900"/>
      <Setter Property="MaxHeight" Value="Infinity"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Карточки -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.card.accentTop">
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.rangeCard.current">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}"/>
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />

    </Style>

    <Style Selector="TextBlock.subtle">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Opacity" Value="0.78" />
    </Style>

    <Style Selector="UserControl.page">
      <Style.Animations>
        <Animation Duration="0:0:0.14">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.88" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Акцентная кнопка -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- Подсветка элементов визуализации -->
    <Style Selector="controls|HighlightBorder">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"/>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="1.5" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="controls|HighlightBorder.hl-compare">
      <Setter Property="Background" Value="{DynamicResource HighlightBrush}" />
      <Setter Property="Foreground" Value="#212121" />
    </Style>
    <Style Selector="controls|HighlightBorder.hl-move">
      <Setter Property="Background" Value="{DynamicResource OkBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Дополнительный отступ контента вкладок -->
    <Style Selector="UserControl.tabRoot">
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="RowBackground" Value="Transparent" />
    </Style>

    <!-- Тематические стили DataGrid: шапка, ячейки и строки следуют цветам приложения -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover /template/ ContentPresenter#PART_ColumnHeaderGripper">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridCell:focus">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="DataGridCell:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
    </Style>
    <Style Selector="DataGridCell:selected">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
    </Style>

    <!-- Компактные таблицы (журнал, эксперименты): мельче шрифт, чтобы текст влезал -->
    <Style Selector="DataGrid.compact">
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="DataGrid.compact DataGridColumnHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGrid.compact DataGridCell">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </Application.Styles>
</Application>
