<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SortLab.Controls" x:Class="SortLab.Views.Task3View">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,5,0,9">
      <TextBlock Classes="subtle" HorizontalAlignment="Center" Text="Слова"/>
      <TextBlock Classes="hero" Text="Сортировка слов"/>
      <TextBlock Text="{Binding WordsInfo}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}"/>
    </StackPanel>
    <controls:DetailButton x:Name="LegendButton" Classes="link" Content="Обозначения"
                           HorizontalAlignment="Left" VerticalAlignment="Center">
      <controls:DetailButton.Detail>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SortLegend}"/>
      </controls:DetailButton.Detail>
    </controls:DetailButton>
    <Grid Grid.Row="1">
      <Grid x:Name="LegendRail" ColumnDefinitions="*,1160,*" IsVisible="False">
        <Border HorizontalAlignment="Right" Margin="0,0,16,0" Padding="12,16" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardBorderBrush}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SortLegend}"/>
        </Border>
      </Grid>
      <Border MaxWidth="1160" Classes="scene">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="6">
          <TextBlock Classes="h2" Text="Слова по порядку" TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
            <controls:WordSortVisualizer DelayMs="{Binding DelayMs}" Words="{Binding Chips}" Message="{Binding VisualMessage}" ChipBrush="{Binding Settings.BarNormalBrush}" TextBrush="{Binding Settings.LabelBrush}" CompareBrush="{Binding Settings.BarCompareBrush}" SwapBrush="{Binding Settings.BarSwapBrush}" SortedBrush="{Binding Settings.BarSortedBrush}" PivotBrush="{Binding Settings.BarPivotBrush}"/>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="h2" Text="Частота слов" TextWrapping="Wrap"/>
            <TextBlock Classes="subtle" Text="{Binding FrequencyInfo}" TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding Frequencies}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="*"/>
              <DataGridTemplateColumn Header="Число повторений" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ProgressBar Minimum="0" Maximum="{Binding $parent[DataGrid].DataContext.MaxFrequency}" Value="{Binding Count}" Height="8" Foreground="{DynamicResource AccentBrush}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Частота" Binding="{Binding Count}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
    <ScrollViewer MaxWidth="1160" Grid.Row="2" MaxHeight="82" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding ProgressText}" Classes="subtle" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Explanation}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="6"/>
      </StackPanel>
    </ScrollViewer>
    <controls:PlaybackControls Grid.Row="3" Margin="0,0,0,10"/>
    <Border MaxWidth="1160" Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
        <controls:DetailButton Classes="link" Content="Текст и параметры">
          <controls:DetailButton.Detail>
            <TabControl Width="830">
              <TabItem Header="Параметры">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24" VerticalAlignment="Top">
                  <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Исходный текст" Classes="subtle"/>
                    <TextBox Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220" Watermark="Введите или загрузите текст..."/>
                    <WrapPanel>
                      <Button Margin="0,0,6,4" Content="Из файла…" Click="OnBrowse"/>
                      <Button Content="Разобрать" Classes="primary" Command="{Binding ApplyTextCommand}"/>
                    </WrapPanel>
                    <CheckBox Content="Игнорировать регистр" IsChecked="{Binding IgnoreCase}"/>
                    <TextBlock Text="{Binding WordsInfo}" Classes="subtle" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Алгоритм сортировки слов" Classes="subtle"/>
                    <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Slider Minimum="0" Maximum="2000" Value="{Binding DelayMs}"/>
                    <TextBlock Text="{Binding DelayMs, StringFormat='Задержка: {0:F0} мс'}" Classes="subtle"/>
                    <TextBlock Text="Генерация текста" TextWrapping="Wrap" Classes="h2"/>
                    <TextBlock Text="Сгенерировать тестовый текст" Classes="subtle"/>
                    <WrapPanel>
                      <NumericUpDown Minimum="50" Maximum="20000" Increment="50" Value="{Binding GenerateCount}" Width="120"/>
                      <TextBlock Text="слов" VerticalAlignment="Center"/>
                      <Button Content="Сгенерировать" Command="{Binding GenerateTextCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Описание и статистика">
                <Grid ColumnDefinitions="5*,3*" ColumnSpacing="24">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Как работает алгоритм" Classes="h2"/>
                    <TextBlock Text="{Binding SelectedAlgorithm.Description}" TextWrapping="Wrap" Classes="subtle"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Статистика" Classes="h2"/>
                    <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Comparisons, StringFormat='Сравнений: {0}'}"/>
                    <TextBlock Text="{Binding Moves, StringFormat='Операций размещения: {0}'}"/>
                    <TextBlock Text="В быстрой сортировке сравнение сопоставляет слово с опорным, а обмен двух слов считается одним размещением. В MSD размещение — запись слова из корзины в массив. Проверка символа для выбора корзины не сравнивает два слова, поэтому счётчик сравнений остаётся нулевым." TextWrapping="Wrap" Classes="subtle"/>
                  </StackPanel>
                </Grid>
              </TabItem>
            </TabControl>
          </controls:DetailButton.Detail>
        </controls:DetailButton>
        <Button Classes="link" Content="К замерам времени" Command="{Binding $parent[Window].DataContext.OpenBenchmarksCommand}"/>
        <controls:DetailButton Classes="link" Content="Журнал операций">
          <controls:DetailButton.Detail><controls:LogView Width="820" Height="320"/></controls:DetailButton.Detail>
        </controls:DetailButton>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
