<UserControl x:Class="SortLab.Views.Task3View"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SortLab.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1250" d:DesignHeight="720">

  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="3*" MinHeight="210" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="185" />
    </Grid.RowDefinitions>

    <!-- ВЕРХНАЯ ЧАСТЬ -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="25*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="41*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="34*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- ЛЕВАЯ ПАНЕЛЬ -->
      <Border Grid.Column="0" Classes="card">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Text="Текст" Classes="h2" />
            <TextBox Text="{Binding InputText}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="120" MaxHeight="220" Watermark="Введите или загрузите текст..." />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Из файла..." Click="OnBrowse" />
              <Button Content="Разобрать" Classes="accent" Command="{Binding ApplyTextCommand}" />
            </StackPanel>
            <CheckBox Content="Игнорировать регистр" IsChecked="{Binding IgnoreCase}" />
            <TextBlock Text="{Binding WordsInfo}" Classes="subtle" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

            <Separator Margin="0,2,0,0" />
            <TextBlock Text="Сгенерировать тестовый текст" Classes="subtle" />
            <WrapPanel>
              <NumericUpDown Minimum="50" Maximum="20000" Increment="50" Value="{Binding GenerateCount}" Width="120" />
              <TextBlock Text="слов" VerticalAlignment="Center" />
              <Button Content="Сгенерировать" Command="{Binding GenerateTextCommand}" Margin="6,0,0,0" />
            </WrapPanel>

            <Separator Margin="0,2,0,0" />
            <TextBlock Text="Алгоритм сортировки слов" Classes="subtle" />
            <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6">
              <Button Grid.Row="0" Grid.Column="0" Content="Старт" Classes="accent" HorizontalContentAlignment="Center"
                      Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
              <Button Grid.Row="0" Grid.Column="1" Content="Пауза" HorizontalContentAlignment="Center"
                      Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" />
              <Button Grid.Row="1" Grid.Column="0" Content="Продолжить" HorizontalContentAlignment="Center"
                      Command="{Binding ContinueCommand}" IsEnabled="{Binding IsPaused}" />
              <Button Grid.Row="1" Grid.Column="1" Content="Шаг" HorizontalContentAlignment="Center"
                      Command="{Binding StepCommand}" IsEnabled="{Binding CanStep}" />
              <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Сброс" HorizontalContentAlignment="Center"
                      Command="{Binding ResetCommand}" />
            </Grid>

            <TextBlock Text="Задержка между шагами (0–2000 мс)" Classes="subtle" Margin="0,4,0,0" />
            <Slider Minimum="0" Maximum="2000" Value="{Binding DelayMs}" />
            <TextBlock Text="{Binding DelayMs, StringFormat='Задержка: {0:F0} мс'}" Classes="subtle" />

            <StackPanel Spacing="3" Margin="0,4,0,0">
              <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Comparisons, StringFormat='Сравнений: {0}'}" />
              <TextBlock Text="{Binding Moves, StringFormat='Операций размещения: {0}'}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Stretch" />

      <!-- ЦЕНТР: слова + частоты + пояснение -->
      <Grid Grid.Column="2" RowDefinitions="3*,Auto,Auto,2*" RowSpacing="6" Margin="8,0,8,0">
        <Border Grid.Row="0" Classes="card accentTop">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Визуализация слов" Classes="h2" Margin="0,0,0,6" />
            <controls:WordSortVisualizer DelayMs="{Binding DelayMs}" Words="{Binding Chips}" Message="{Binding VisualMessage}"
                                         ChipBrush="{DynamicResource ChipBgBrush}"
                                         TextBrush="{Binding Settings.LabelBrush}"
                                         CompareBrush="{DynamicResource HighlightBrush}"
                                         SwapBrush="{DynamicResource OkBrush}"
                                         SortedBrush="{DynamicResource PanelBgBrush}"
                                         PivotBrush="{DynamicResource AccentBrush}" />
          </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Частоты слов" Classes="h2" />
        <TextBlock Grid.Row="2" Text="{Binding FrequencyInfo}" Classes="subtle" />
        <Border Grid.Row="3" Classes="card" Padding="4" MaxHeight="150">
          <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    ItemsSource="{Binding Frequencies}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="*" />
              <DataGridTextColumn Header="Частота" Binding="{Binding Count}" Width="90" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="6" Background="Transparent" HorizontalAlignment="Stretch" />

      <!-- ПРАВО: пояснение + журнал -->
      <Grid Grid.Column="4" RowDefinitions="Auto,*" RowSpacing="8">
        <Border Grid.Row="0" Classes="card" Padding="12,8">
          <StackPanel Spacing="2">
            <TextBlock Text="Объяснение простыми словами" Classes="h2" />
            <ScrollViewer Height="50" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" MinHeight="30" />
          </ScrollViewer>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card">
          <controls:LogView />
        </Border>
      </Grid>
    </Grid>

    <GridSplitter Grid.Row="1" Height="6" Background="Transparent" />

    <!-- НИЗ: эксперименты -->
    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="200,*,*" ColumnSpacing="12">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
          <TextBlock Text="Эксперименты" Classes="h2" />
          <TextBlock Text="{Binding BenchLengthsText}" Classes="subtle" TextWrapping="Wrap" />
          <NumericUpDown Minimum="50" Maximum="50000" Increment="50" Value="{Binding CustomBenchLength}"
                         HorizontalAlignment="Stretch" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button Grid.Column="0" Content="Добавить" Command="{Binding AddBenchLengthCommand}"
                    HorizontalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Сбросить" Command="{Binding ResetBenchLengthsCommand}"
                    HorizontalContentAlignment="Center" />
          </Grid>
          <TextBlock Text="Прогонов на алгоритм (1–20)" Classes="subtle" />
          <NumericUpDown Minimum="1" Maximum="20" Increment="1" Value="{Binding BenchRuns}"
                         Width="120" HorizontalAlignment="Left" />
          <Button Content="Запустить эксперименты" Classes="accent" Command="{Binding RunBenchmarkCommand}" IsEnabled="{Binding CanRunBench}" />
          <Button Content="Отменить" Command="{Binding CancelBenchmarkCommand}" IsEnabled="{Binding BenchRunning}" />
          <ProgressBar Value="{Binding BenchProgress}" Maximum="100" Height="10" />
          <TextBlock Text="{Binding BenchStatus}" Classes="subtle" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource PanelBgBrush}" CornerRadius="8" Padding="4">
          <DataGrid Classes="compact" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    ItemsSource="{Binding BenchmarkResults}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Длина" Binding="{Binding Length}" Width="52"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
              <DataGridTextColumn Header="Алгоритм" Binding="{Binding Algorithm}" Width="*" MinWidth="112"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
              <DataGridTextColumn Header="Время, мс" Binding="{Binding AvgMs, StringFormat=F2}" Width="84"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
              <DataGridTextColumn Header="Минимум, мс" Binding="{Binding MinMs, StringFormat=F2}" Width="84"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
              <DataGridTextColumn Header="Сравнения" Binding="{Binding Comparisons}" Width="88"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
              <DataGridTextColumn Header="Операции" Binding="{Binding Moves}" Width="84"
                                  HeaderTemplate="{StaticResource GridHeaderTemplate}" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="*,*" RowSpacing="8">
          <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="8">
            <controls:BarChart Categories="{Binding ChartCategories}" Series="{Binding ChartSeries}"
                               XAxisTitle="Длина текста, слов" YAxisTitle="Время, мс"
                               GridBrush="{Binding Settings.GridBrush}" LabelBrush="{Binding Settings.LabelBrush}"
                               BarBrush1="{Binding Settings.ChartBrush1}" BarBrush2="{Binding Settings.ChartBrush2}"
                               BarBrush3="{Binding Settings.ChartBrush3}" BarBrush4="{Binding Settings.ChartBrush4}" />
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" CornerRadius="8">
            <controls:LineChart Categories="{Binding ChartCategories}" Series="{Binding ChartSeries}"
                                XAxisTitle="Длина текста, слов" YAxisTitle="Время, мс"
                                GridBrush="{Binding Settings.GridBrush}" LabelBrush="{Binding Settings.LabelBrush}"
                                LineBrush1="{Binding Settings.ChartBrush1}" LineBrush2="{Binding Settings.ChartBrush2}"
                                LineBrush3="{Binding Settings.ChartBrush3}" LineBrush4="{Binding Settings.ChartBrush4}" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
