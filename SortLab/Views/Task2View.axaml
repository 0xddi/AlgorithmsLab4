<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SortLab.Controls" x:Class="SortLab.Views.Task2View">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
    <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,5,0,9">
      <TextBlock Classes="subtle" HorizontalAlignment="Center" Text="CSV-таблицы"/>
      <TextBlock Classes="hero" Text="Внешняя сортировка"/>
      <TextBlock Text="{Binding FileName}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}"/>
    </StackPanel>
    <controls:DetailButton x:Name="LegendButton" Classes="link" Content="Обозначения"
                           HorizontalAlignment="Left" VerticalAlignment="Center">
      <controls:DetailButton.Detail>
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TapeLegend}"/>
      </controls:DetailButton.Detail>
    </controls:DetailButton>
    <Grid Grid.Row="1">
      <Grid x:Name="LegendRail" ColumnDefinitions="*,1160,*" IsVisible="False">
        <Border HorizontalAlignment="Right" Margin="0,0,16,0" Padding="12,16" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardBorderBrush}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TapeLegend}"/>
        </Border>
      </Grid>
      <Border MaxWidth="1160" Classes="scene">
        <TabControl>
          <TabItem Header="Серии и ленты">
            <Panel>
              <TextBlock Classes="subtle" IsVisible="{Binding !Tapes.Count}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Серии появятся после первого шага сортировки."/>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Tapes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="8" Padding="8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <ItemsControl ItemsSource="{Binding Series}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="6" Padding="4" Margin="2">
                                  <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <controls:HighlightBorder IsCompared="{Binding IsCompared}" IsMoved="{Binding IsMoved}">
                                          <TextBlock Text="{Binding Text}" FontSize="12"/>
                                        </controls:HighlightBorder>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </TabItem>
          <TabItem Header="Входная таблица">
            <DataGrid x:Name="SourceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding Table.Rows}"/>
          </TabItem>
          <TabItem Header="Результат">
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ItemsSource="{Binding ResultTable.Rows}"/>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
    <ScrollViewer MaxWidth="1160" Grid.Row="2" MaxHeight="82" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding PhaseText}" Classes="subtle" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Explanation}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="6"/>
      </StackPanel>
    </ScrollViewer>
    <controls:PlaybackControls Grid.Row="3" Margin="0,0,0,10"/>
    <Border MaxWidth="1160" Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
        <Button Classes="link" Content="Открыть CSV…" Click="OnBrowse"/>
        <controls:DetailButton Classes="link" Content="Ключ и параметры">
          <controls:DetailButton.Detail>
            <TabControl Width="830">
              <TabItem Header="Параметры">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24" VerticalAlignment="Top">
                  <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Метод внешней сортировки" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding SorterNames}" SelectedIndex="{Binding SelectedSorterIndex}" HorizontalAlignment="Stretch"/>
                    <StackPanel Spacing="4" IsVisible="{Binding IsMultiway}">
                      <TextBlock Text="Число путей k:" VerticalAlignment="Center"/>
                      <NumericUpDown Minimum="2" Maximum="8" Increment="1" Value="{Binding MultiwayK}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <TextBlock Text="Ключевой атрибут" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding Table.Headers}" SelectedItem="{Binding SelectedKeyColumn}" HorizontalAlignment="Stretch"/>
                    <Slider Minimum="0" Maximum="2000" Value="{Binding DelayMs}"/>
                    <TextBlock Text="{Binding DelayMs, StringFormat='Задержка: {0:F0} мс'}" Classes="subtle"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Формат и отбор строк" TextWrapping="Wrap" Classes="h2"/>
                    <TextBlock Text="Разделитель" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox SelectedIndex="{Binding SelectedSeparatorIndex}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="Авто (по файлу)"/>
                      <ComboBoxItem Content=", (запятая)"/>
                      <ComboBoxItem Content="; (точка с запятой)"/>
                      <ComboBoxItem Content="Tab"/>
                    </ComboBox>
                    <TextBlock Text="Тип ключа" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding KeyTypes}" SelectedIndex="{Binding SelectedKeyTypeIndex}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Направление" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox SelectedIndex="{Binding SelectedDirectionIndex}" HorizontalAlignment="Stretch">
                      <ComboBoxItem Content="По возрастанию"/>
                      <ComboBoxItem Content="По убыванию"/>
                    </ComboBox>
                    <TextBlock Text="Фильтр записей (необязательно)" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterColumnIndex}" HorizontalAlignment="Stretch"/>
                    <TextBox Watermark="Значение фильтра" Text="{Binding FilterValue}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="Примеры таблиц" TextWrapping="Wrap" Classes="h2"/>
                    <TextBlock Text="Примеры таблиц из задания" Classes="subtle" Margin="0,4,0,0"/>
                    <ComboBox ItemsSource="{Binding SampleNames}" SelectedIndex="{Binding SelectedSampleIndex}" HorizontalAlignment="Stretch"/>
                    <Button Content="Загрузить пример" Command="{Binding LoadSampleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="Сведения о файле" TextWrapping="Wrap" Classes="h2"/>
                    <TextBlock Text="{Binding SourcePath}" Classes="subtle" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SeparatorInfo}" Classes="subtle" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultInfo}" Classes="subtle" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </TabItem>
              <TabItem Header="Описание и статистика">
                <Grid ColumnDefinitions="5*,3*" ColumnSpacing="24">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Как работает алгоритм" Classes="h2"/>
                    <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" Classes="subtle"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Статистика" Classes="h2"/>
                    <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Comparisons, StringFormat='Сравнений: {0}'}"/>
                    <TextBlock Text="{Binding Moves, StringFormat='Перемещений: {0}'}"/>
                    <TextBlock Text="Сравнение проверяет ключи двух записей. Перемещение — запись целой строки на ленту. Одна строка может учитываться несколько раз, если проходит через несколько слияний." TextWrapping="Wrap" Classes="subtle"/>
                  </StackPanel>
                </Grid>
              </TabItem>
            </TabControl>
          </controls:DetailButton.Detail>
        </controls:DetailButton>
        <Button Classes="link" Content="Сохранить CSV…" Click="OnSaveResult" IsEnabled="{Binding HasResult}"/>
        <controls:DetailButton Classes="link" Content="Журнал операций">
          <controls:DetailButton.Detail><controls:LogView Width="820" Height="320"/></controls:DetailButton.Detail>
        </controls:DetailButton>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
