<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:SortLab.Controls" x:Class="SortLab.Views.Task1View">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12" MaxWidth="1160">
    <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="0,15,0,12">
      <TextBlock Classes="subtle" HorizontalAlignment="Center" Text="Внутренняя сортировка" FontWeight="SemiBold"/>
      <TextBlock Classes="hero" Text="{Binding SelectedAlgorithm.Name}"/>
      <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}"/>
    </StackPanel>
    <Border Grid.Row="1" Classes="scene">
      <controls:SortVisualizer x:Name="Visualizer" DelayMs="{Binding DelayMs}" Bars="{Binding Bars}" ShowLabels="{Binding Settings.ShowValueLabels}" NormalBrush="{Binding Settings.BarNormalBrush}" CompareBrush="{Binding Settings.BarCompareBrush}" SwapBrush="{Binding Settings.BarSwapBrush}" SortedBrush="{Binding Settings.BarSortedBrush}" PivotBrush="{Binding Settings.BarPivotBrush}" LabelBrush="{Binding Settings.LabelBrush}"/>
    </Border>
    <ScrollViewer Grid.Row="2" MaxHeight="82" HorizontalScrollBarVisibility="Disabled">
      <TextBlock Text="{Binding Explanation}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="6"/>
    </ScrollViewer>
    <controls:PlaybackControls Grid.Row="3" Margin="0,0,0,10"/>
    <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
        <TextBlock VerticalAlignment="Center" Text="{Binding ArrayLength, StringFormat='Элементов: {0}'}"/>
        <controls:DetailButton Classes="link" Content="Изменить массив">
          <controls:DetailButton.Detail>
            <Grid ColumnDefinitions="*,*" Width="640" ColumnSpacing="24" VerticalAlignment="Top">
              <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="Массив (0–999, через запятую)" Classes="subtle" Margin="0,6,0,0"/>
                <TextBox Text="{Binding ManualInput}" AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="70"/>
                <Button Content="Применить" Command="{Binding ApplyManualCommand}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding InputError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding InputError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Генерация массива" TextWrapping="Wrap" Classes="h2"/>
                <TextBlock Text="Размер массива (5–100)" Classes="subtle" Margin="0,6,0,0"/>
                <NumericUpDown Minimum="5" Maximum="100" Increment="1" Value="{Binding ArraySize}"/>
                <Button Content="Новый массив" Classes="primary" Command="{Binding GenerateArrayCommand}" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Grid>
          </controls:DetailButton.Detail>
        </controls:DetailButton>
        <controls:DetailButton Classes="link" Content="{Binding DelayMs, StringFormat='Интервал: {0:F0} мс'}">
          <controls:DetailButton.Detail>
            <Grid ColumnDefinitions="*" Width="340" ColumnSpacing="24" VerticalAlignment="Top">
              <StackPanel Grid.Column="0" Spacing="8">
                <Slider Minimum="0" Maximum="2000" Value="{Binding DelayMs}" TickFrequency="100" IsSnapToTickEnabled="False"/>
                <TextBlock Text="{Binding DelayMs, StringFormat='Задержка: {0:F0} мс'}" Classes="subtle"/>
              </StackPanel>
            </Grid>
          </controls:DetailButton.Detail>
        </controls:DetailButton>
        <controls:DetailButton Classes="link" Content="Алгоритм">
          <controls:DetailButton.Detail>
            <Grid ColumnDefinitions="*,*" Width="640" ColumnSpacing="24" VerticalAlignment="Top">
              <StackPanel Grid.Column="0" Spacing="8">
                <ComboBox ItemsSource="{Binding Algorithms}" SelectedItem="{Binding SelectedAlgorithm}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Text="Описание и статистика" TextWrapping="Wrap" Classes="h2"/>
                <TextBlock Text="{Binding AlgorithmDescription}" TextWrapping="Wrap" Classes="subtle"/>
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarNormalBrush}"/>
                    <TextBlock Text="Обычный элемент"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarCompareBrush}"/>
                    <TextBlock Text="Сравнение"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarSwapBrush}"/>
                    <TextBlock Text="Перестановка"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarSortedBrush}"/>
                    <TextBlock Text="Отсортировано"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="10" Height="10" Fill="{Binding Settings.BarPivotBrush}"/>
                    <TextBlock Text="Опорный элемент"/>
                  </StackPanel>
                  <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Comparisons, StringFormat='Сравнений: {0}'}"/>
                  <TextBlock Text="{Binding Swaps, StringFormat='Перестановок: {0}'}"/>
                  <TextBlock Text="{Binding Assignments, StringFormat='Присваиваний: {0}'}"/>
                  <TextBlock Text="{Binding SilentRunText}" Classes="subtle" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </controls:DetailButton.Detail>
        </controls:DetailButton>
        <controls:DetailButton Classes="link" Content="Журнал операций">
          <controls:DetailButton.Detail><controls:LogView Width="820" Height="320"/></controls:DetailButton.Detail>
        </controls:DetailButton>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
