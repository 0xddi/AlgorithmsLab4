<UserControl x:Class="SortLab.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620">

  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" Margin="0,10">
      <TextBlock Classes="hero" Text="Настройки" Margin="0,0,0,10"/>
      <Border Classes="scene">
        <StackPanel Spacing="10">
          <TextBlock Text="Оформление" Classes="h2" />
          <StackPanel Spacing="6">
            <ToggleSwitch IsChecked="{Binding DarkTheme}" OnContent="Тёмная тема" OffContent="Светлая тема" />
            <TextBlock Text="Тема применяется ко всем вкладкам мгновенно и сохраняется между запусками."
                       Classes="subtle" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>

          <TextBlock Text="Цветовая схема визуализации" Classes="subtle" />
          <ComboBox ItemsSource="{Binding ColorSchemes}" SelectedIndex="{Binding ColorSchemeIndex}" MinWidth="200" />

          <TextBlock Text="{Binding MovementPercent, StringFormat='Перемещение: {0:F0}% интервала шага'}" />
          <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                  AutomationProperties.Name="Длительность перемещения" Value="{Binding MovementPercent}"/>
          <TextBlock Classes="subtle" Text="Оставшаяся часть интервала — пауза после движения. При 0% элементы меняют позицию мгновенно." TextWrapping="Wrap"/>
          <CheckBox Content="Показывать подписи значений над столбиками" IsChecked="{Binding ShowValueLabels}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Classes="scene">
        <StackPanel Spacing="8">
          <TextBlock Text="Где хранятся настройки" Classes="h2" />
          <TextBlock TextWrapping="Wrap" Classes="subtle"
                     Text="Настройки сохраняются в JSON-файл в папке %APPDATA%\SortLab\settings.json и восстанавливаются при запуске приложения." />
          <TextBlock TextWrapping="Wrap" Classes="subtle"
                     Text="Задержка между шагами задаётся отдельно на каждой вкладке (0–2000 мс), потому что у разных заданий свой удобный темп." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
